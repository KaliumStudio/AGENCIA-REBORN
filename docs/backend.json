
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the AM Agency Portal with specific roles and an internal display name.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "role": {
          "type": "string",
          "description": "The role of the user within the portal (admin, editor, or client).",
          "enum": ["admin", "editor", "client"]
        },
        "displayName": {
          "type": "string",
          "description": "Internal display name for the user."
        },
        "clientId": {
          "type": "string",
          "description": "Reference to the Client entity if the user's role is 'client'."
        },
        "active": {
          "type": "boolean",
          "description": "Indicates whether the user account is active."
        },
        "editorDetails": {
          "type": "object",
          "properties": {
            "dailyCapacity": { "type": "number" },
            "workingDays": { "type": "array", "items": { "type": "string" } },
            "specializedFormats": { "type": "array", "items": { "type": "string" } },
            "payPerCreative": { "type": "number" },
            "paymentContract": { "type": "string", "enum": ["pago fijo", "pago por creativos acumulados"] },
            "paymentPeriod": { "type": "string", "enum": ["quincenal", "mensual", "express"] }
          }
        }
      },
      "required": ["id", "role", "displayName", "active"]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Represents a client of the AM Agency.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "contactEmail": { "type": "string" },
        "creativeQuota": { "type": "number", "description": "Remaining creative pieces for the client." },
        "imageQuota": { "type": "number", "description": "Remaining AI image generation credits." },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "contact", "createdAt"]
    },
    "Batch": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Batch",
      "type": "object",
      "description": "Represents a batch of creative requests submitted by a client.",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientUserUid": { "type": "string" },
        "title": { "type": "string" },
        "productName": { "type": "string" },
        "creativeCount": { "type": "number" },
        "videoSpecs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "script": { "type": "string" },
              "notes": { "type": "string" },
              "format": { "type": "string", "enum": ["UGC IA", "CINEMATICO", "POV", "PODCAST", "IMAGEN", "TRADUCCIÓN SIMPLE", "UGC IA + CINEMATICO"] }
            }
          }
        },
        "referenceLinks": { "type": "string" },
        "landingPage": { "type": "string" },
        "deliveryDeadlineTime": { "type": "string" },
        "status": { "type": "string" },
        "assignedEditorUids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientId", "productName", "referenceLinks", "landingPage", "deliveryDeadlineTime", "status"]
    },
    "LandingRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LandingRequest",
      "type": "object",
      "description": "Represents a request for a custom landing page development.",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientUserUid": { "type": "string" },
        "platform": { "type": "string", "enum": ["shopify", "tiendanube", "other"] },
        "productName": { "type": "string" },
        "bundles": { "type": "string" },
        "driveLink": { "type": "string" },
        "accessCredentials": { "type": "string" },
        "deadline": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "delivered", "approved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientId", "clientUserUid", "platform", "productName", "driveLink", "deadline", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" }
        }
      },
      {
        "path": "/clients/{clientId}",
        "definition": {
          "entityName": "Client",
          "schema": { "$ref": "#/backend/entities/Client" }
        }
      },
      {
        "path": "/batches/{batchId}",
        "definition": {
          "entityName": "Batch",
          "schema": { "$ref": "#/backend/entities/Batch" }
        }
      },
      {
        "path": "/landing-requests/{requestId}",
        "definition": {
          "entityName": "LandingRequest",
          "schema": { "$ref": "#/backend/entities/LandingRequest" }
        }
      }
    ]
  }
}
