rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin';
    }

    function isEditor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'editor';
    }

    function isClient() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'client';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'clientId', 'active'])
      );
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow get: if isSignedIn() && (isAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().clientId == clientId));
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        (isClient() && getUserData().clientId == resource.data.clientId) ||
        (isEditor() && request.auth.uid in resource.data.assignedEditorUids)
      );
      allow create: if isAdmin() || (isClient() && request.resource.data.clientId == getUserData().clientId);
      allow update: if isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().clientId == resource.data.clientId) || 
        (isEditor() && request.auth.uid in resource.data.assignedEditorUids)
      );
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid in resource.data.memberUids
      );
      allow create: if isSignedIn() && 
                   request.auth.uid == request.resource.data.senderUid &&
                   request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if isAdmin() || (resource != null && request.auth.uid == resource.data.senderUid);
    }
  }
}