rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Obtiene el documento de usuario de forma segura (sin fallar si no existe)
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Verifica si el usuario existe y tiene un rol específico
    function hasRole(role) {
      let user = getUserDoc();
      return isSignedIn() && user != null && user.data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return hasRole('editor');
    }

    function isClient() {
      return hasRole('client');
    }

    // Verifica si el usuario es el dueño del documento solicitado
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // El dueño puede actualizar solo campos no sensibles (incluyendo notificaciones)
      // El admin puede actualizar todo
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'clientId', 'active'])
      );
      
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow get: if isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().data.clientId == clientId) || 
        isAdmin()
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow get: if isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserDoc().data.clientId == resource.data.clientId || 
          (isEditor() && request.auth.uid in resource.data.assignedEditorUids)
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (isClient() && getUserDoc().data.clientId == resource.data.clientId) || 
          (isEditor() && request.auth.uid in resource.data.assignedEditorUids)
        ))
      );
      allow create: if isAdmin() || (isClient() && request.resource.data.clientId == getUserDoc().data.clientId);
      allow update: if isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserDoc().data.clientId == resource.data.clientId || 
          (isEditor() && request.auth.uid in resource.data.assignedEditorUids)
        ))
      );
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().data.clientId == resource.data.clientId) ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().data.clientId == resource.data.clientId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().data.clientId == resource.data.clientId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (request.auth.uid == request.resource.data.senderUid);
      allow update, delete: if isAdmin() || (resource != null && request.auth.uid == resource.data.senderUid);
    }
  }
}
