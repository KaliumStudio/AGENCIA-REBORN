rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return hasRole('editor');
    }

    function isClient() {
      return hasRole('client');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function belongsToClient(clientId) {
      return (isClient() && getUserData().clientId == clientId) || isAdmin();
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow get: if isAdmin() || belongsToClient(clientId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow get: if isAdmin() || belongsToClient(resource.data.clientId) || (isEditor() && request.auth.uid in resource.data.assignedEditorUids);
      allow list: if isAdmin() || (isClient() && belongsToClient(resource.data.clientId)) || (isEditor() && request.auth.uid in resource.data.assignedEditorUids);
      allow create: if isAdmin() || (isClient() && request.resource.data.clientId == getUserData().clientId);
      allow update: if (isAdmin() || belongsToClient(resource.data.clientId) || (isEditor() && request.auth.uid in resource.data.assignedEditorUids)) && (request.resource.data.clientId == resource.data.clientId);
      allow delete: if isAdmin() || belongsToClient(resource.data.clientId);
    }

    match /chats/{chatId} {
      allow get, list: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.memberUids || getUserData().clientId == resource.data.clientId));
      allow create: if isAdmin() || (isSignedIn() && (request.auth.uid in request.resource.data.memberUids || getUserData().clientId == request.resource.data.clientId));
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.memberUids || getUserData().clientId == resource.data.clientId));
      allow delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.memberUids || getUserData().clientId == resource.data.clientId));
      allow create: if (isAdmin() || (isSignedIn() && (request.auth.uid in request.resource.data.memberUids || getUserData().clientId == request.resource.data.clientId))) && (request.resource.data.senderUid == request.auth.uid);
      allow update, delete: if isAdmin() || (resource != null && isOwner(resource.data.senderUid));
    }

  }
}