rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chats/{chatId}/{allPaths=**} {
      // Permitir acceso si el usuario está autenticado
      // (En una app real, verificarías si el UID está en la lista de miembros de la colección de Firestore)
      allow read, write: if request.auth != null;
    }
    
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}